{
  "name": "opencode-telegram-bot",
  "version": "1.0.5",
  "type": "module",
  "description": "Telegram bot that forwards messages to an OpenCode agent",
  "main": "./dist/index.js",
  "bin": {
    "opencode-telegram-bot": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "opencode serve",
    "build": "ncc build src/index.ts --out dist",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts"
  },
  "keywords": [
    "opencode",
    "telegram",
    "bot",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.56",
    "telegraf": "^4.15.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.1.5"
  }
}
